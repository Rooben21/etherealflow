{
  "name": "ContentCampaign",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "config": {
      "type": "object"
    },
    "strategy": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "default": "draft"
    },
    "total_count": {
      "type": "number"
    },
    "ready_count": {
      "type": "number",
      "default": 0
    },
    "worker_token": {
      "type": "string",
      "default": ""
    },
    "worker_started_at": {
      "type": "string"
    },
    "regenerate_item_id": {
      "type": "string",
      "default": ""
    },
    "resume_status": {
      "type": "string"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "config",
    "status",
    "total_count"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}