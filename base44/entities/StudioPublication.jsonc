{
  "name": "StudioPublication",
  "type": "object",
  "properties": {
    "video_id": {
      "type": "string"
    },
    "video_uri": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "account_name": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "scheduled_at": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "post_id": {
      "type": "string"
    },
    "published_url": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "media": {
      "type": "object"
    },
    "message": {
      "type": "string"
    },
    "settings_snapshot": {
      "type": "object"
    },
    "title_snapshot": {
      "type": "string"
    },
    "dispatch_token": {
      "type": "string",
      "default": ""
    },
    "dispatch_date": {
      "type": "string"
    },
    "send_started_at": {
      "type": "string"
    },
    "accepted_at": {
      "type": "string"
    },
    "published_confirmed_at": {
      "type": "string"
    },
    "last_checked_at": {
      "type": "string"
    },
    "next_attempt_at": {
      "type": "string"
    },
    "attempt_count": {
      "type": "number",
      "default": 0
    },
    "worker_token": {
      "type": "string",
      "default": ""
    },
    "worker_until": {
      "type": "string",
      "default": ""
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "baseline_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "video_id",
    "account_id",
    "state"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}