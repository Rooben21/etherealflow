{
  "name": "StudioVideo",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "default": "uk"
    },
    "tone": {
      "type": "string"
    },
    "duration": {
      "type": "number",
      "default": 30
    },
    "instructions": {
      "type": "string"
    },
    "source_text": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "rights_confirmed": {
      "type": "boolean",
      "default": false
    },
    "ad_enabled": {
      "type": "boolean",
      "default": true
    },
    "ad_text": {
      "type": "string"
    },
    "script": {
      "type": "string"
    },
    "hook": {
      "type": "string"
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "visual": {
            "type": "string"
          },
          "narration": {
            "type": "string"
          },
          "seconds": {
            "type": "number"
          }
        }
      }
    },
    "captions": {
      "type": "object"
    },
    "voice": {
      "type": "string",
      "default": "river"
    },
    "audio_url": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "video_uri": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "draft"
    },
    "last_error": {
      "type": "string"
    },
    "approved": {
      "type": "boolean",
      "default": false
    },
    "credit_limit": {
      "type": "number",
      "default": 35
    }
  },
  "required": [
    "title",
    "topic"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}